-- ==================== HTTP REQUESTS ====================
local function githubRequest(url, method, bodyData)
    local requestFunc = request or http_request or (syn and syn.request)
    if not requestFunc then return nil, "Executor does not support HTTP requests" end

    local headers = {
        ["Authorization"] = "token " .. GITHUB_TOKEN,
        ["User-Agent"] = "Roblox-App",
        ["Accept"] = "application/vnd.github.v3+json"
    }

    local options = {
        Url = url,
        Method = method or "GET",
        Headers = headers
    }

    if bodyData then
        headers["Content-Type"] = "application/json"
        options.Body = HttpService:JSONEncode(bodyData)
    end

    local response = requestFunc(options)
    if response and response.Body then
        return response.Body, response.StatusCode
    end
    return nil, "Network error"
end

local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function toBase64(data)
    return ((data:gsub('.', function(x)
        local r, b = '', x:byte()
        for i = 8, 1, -1 do r = r .. (b % 2^i - b % 2^(i - 1) >= 2^(i - 1) and '1' or '0') end
        return r
    end) .. '0000'):gsub('%d%d%d?%d?%d?', function(x)
        if (#x < 6) then return '' end
        local c = 0
        for i = 1, 6 do c = c + (x:sub(i, i) == '1' and 2^(6 - i) or 0) end
        return b64chars:sub(c + 1, c + 1)
    end) .. ({ '', '==', '=' })[#data % 3 + 1])
end

