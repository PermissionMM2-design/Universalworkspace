bindClick(saveCodeBtn, function()
    if not selectedFile then return end
    local newContent = editorTextBox.Text
    local src = selectedFile.source or sourceMode

    updateStatus("Saving file...")
    task.spawn(function()
        if src == "GITHUB" then
            local base64Content = toBase64(newContent)
            local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, selectedFile.path)
            local payload = {
                message = "Updated " .. selectedFile.name .. " via AltPre-Loader Editor",
                content = base64Content,
                sha = selectedFile.sha
            }
            local body, code = githubRequest(url, "PUT", payload)
            if code == 200 or code == 201 then
                updateStatus("Saved to GitHub successfully!")
                editorOverlay.Visible = false
                fetchRepoFiles()
            else
                updateStatus("Error saving to GitHub (Code " .. tostring(code) .. ")")
            end
        else
            local localPath = FOLDER_NAME .. "/" .. selectedFile.name
            if writefile then
                writefile(localPath, newContent)
                updateStatus("Saved locally successfully!")
                editorOverlay.Visible = false
                fetchWorkspaceFiles()
            end
        end
    end)
end)

