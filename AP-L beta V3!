-- Delete Action (Protected by Password)
bindClick(deleteButton, function()
    if not selectedFile then return end

    promptPassword(function()
        local src = selectedFile.source or sourceMode

        if src == "FAVORITES" then
            for i, fav in ipairs(favoriteItems) do
                if fav.name == selectedFile.name then
                    table.remove(favoriteItems, i)
                    break
                end
            end
            saveFavorites()
            renderFavoritesList()
            updateStatus("Removed from Favorites")
            return
        end

        updateStatus("Deleting " .. selectedFile.name .. "...")
        task.spawn(function()
            if src == "GITHUB" then
                local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, selectedFile.path)
                local payload = {
                    message = "Deleted " .. selectedFile.name .. " via AltPre-Loader",
                    sha = selectedFile.sha
                }
                local body, code = githubRequest(url, "DELETE", payload)
                if code == 200 then
                    updateStatus("Deleted from GitHub")
                    fetchRepoFiles()
                else
                    updateStatus("Error deleting file from GitHub")
                end
            else
                local localPath = FOLDER_NAME .. "/" .. selectedFile.name
                if delfile and isfile and isfile(localPath) then
                    delfile(localPath)
                    updateStatus("Deleted local file")
                    fetchWorkspaceFiles()
                end
            end
        end)
    end)
end)

