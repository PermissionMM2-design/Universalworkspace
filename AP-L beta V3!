fetchWorkspaceFiles = function()
    currentView = "FILES"
    selectedFile = nil
    setSelection(nil)
    backButton.Visible = false
    createRepoBtn.Visible = false
    searchBox.PlaceholderText = "🔍 Search local file..."
    searchBox.Text = ""
    hideAllActionButtons()

    buildTitle.Text = "Workspace: " .. FOLDER_NAME
    buildDesc.Text = "Browsing local files inside workspace/" .. FOLDER_NAME .. "."
    updateStatus("Reading workspace files...")

    workspaceFiles = {}
    if listfiles and isfolder and isfolder(FOLDER_NAME) then
        local files = listfiles(FOLDER_NAME)
        for _, filePath in ipairs(files) do
            local cleanName = filePath:match("([^/]+)$") or filePath
            table.insert(workspaceFiles, { name = cleanName, path = filePath, type = "file", source = "WORKSPACE" })
        end
    end

    renderFileList(workspaceFiles)
    updateStatus("Loaded " .. #workspaceFiles .. " local files")
end

fetchUserRepos = function()
    currentView = "REPOS"
    currentPath = ""
    selectedFile = nil
    backButton.Visible = false
    createRepoBtn.Visible = true
    searchBox.PlaceholderText = "🔍 Search repo..."
    searchBox.Text = ""
    hideAllActionButtons()

    buildTitle.Text = "Select Repository"
    buildDesc.Text = "Click on any repository from the left panel to browse its files."
    updateStatus("Fetching repositories...")

    task.spawn(function()
        local url = "https://api.github.com/user/repos?per_page=100&sort=updated"
        local body, code = githubRequest(url, "GET")

        if code == 200 and body then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" then
                userRepos = data
                renderRepoList(userRepos)
                updateStatus("Loaded " .. #userRepos .. " repositories")
                return
            end
        end
        buildTitle.Text = "Error"
        buildDesc.Text = "Failed to fetch repositories. Status Code: " .. tostring(code)
        updateStatus("Failed to load repositories")
    end)
end

fetchRepoFiles = function()
    currentView = "FILES"
    selectedFile = nil
    setSelection(nil)
    backButton.Visible = true
    createRepoBtn.Visible = false
    searchBox.PlaceholderText = "🔍 Search file..."
    searchBox.Text = ""
    hideAllActionButtons()

    dlFolderButton.Visible = true
    createButton.Visible   = true

    local pathDisplay = (currentPath == "" and "/" or "/" .. currentPath)
    updateStatus("Fetching contents of " .. GITHUB_REPO .. pathDisplay .. "...")

    task.spawn(function()
        buildTitle.Text = "Loading files..."
        local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, currentPath)
        local body, code = githubRequest(url, "GET")

        if code == 200 and body then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" then
                githubFiles = {}
                
                table.sort(data, function(a, b)
                    if a.type == b.type then
                        return a.name:lower() < b.name:lower()
                    end
                    return a.type == "dir"
                end)

                for _, item in ipairs(data) do
                    table.insert(githubFiles, {
                        name = item.name,
                        path = item.path,
                        type = item.type,
                        download_url = item.download_url,
                        sha = item.sha,
                        size = item.size,
                        source = "GITHUB"
                    })
                end

                renderFileList(githubFiles)
                buildTitle.Text = "Repo: " .. GITHUB_REPO
                buildDesc.Text = "Current Path: " .. pathDisplay .. "\nSelect a file or open a folder."
                updateStatus("Loaded " .. #githubFiles .. " items")
                return
            end
        end

        renderFileList({})
        buildTitle.Text = "Empty Folder"
        buildDesc.Text = "Status: " .. tostring(code) .. "\nNo items found in " .. pathDisplay .. "."
        updateStatus("Folder is empty or inaccessible")
    end)
end

