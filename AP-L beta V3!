        return
    end

    updateStatus("Executing " .. selectedFile.name .. "...")

    task.spawn(function()
        local scriptContent = nil
        local src = selectedFile.source or sourceMode

        if src == "GITHUB" and selectedFile.download_url then
            local body, code = githubRequest(selectedFile.download_url, "GET")
            if code == 200 and body then scriptContent = body end
        else
            local localPath = FOLDER_NAME .. "/" .. selectedFile.name
            if readfile and isfile and isfile(localPath) then
                scriptContent = readfile(localPath)
            end
        end

        if scriptContent then
            local func, err = loadstring(scriptContent)
            if func then
                local successRun, runErr = pcall(func)
                if successRun then
                    buildTitle.Text = "Execution Successful"
                    buildDesc.Text = "Script " .. selectedFile.name .. " executed without errors."
                    updateStatus("Executed " .. selectedFile.name)
                else
                    buildTitle.Text = "Runtime Error"
                    buildDesc.Text = tostring(runErr)
                    updateStatus("Runtime error during execution")
                end
            else
                buildTitle.Text = "Syntax Error"
                buildDesc.Text = tostring(err)
                updateStatus("Syntax error in script")
            end
        end
    end)
end)

-- Download Single File
bindClick(downloadButton, function()
    if not selectedFile or selectedFile.type == "dir" then return end
    if not writefile then
        buildTitle.Text = "writefile not supported"
        updateStatus("Error: Executor lacks writefile")
        return
    end

    updateStatus("Downloading " .. selectedFile.name .. "...")
    task.spawn(function()
        local body, code = githubRequest(selectedFile.download_url, "GET")
        if body then
            local localPath = FOLDER_NAME .. "/" .. selectedFile.name
            writefile(localPath, body)
            buildTitle.Text = "Download Complete"
            buildDesc.Text = "Saved to workspace/" .. localPath
            updateStatus("Downloaded " .. selectedFile.name)
        else
            buildTitle.Text = "Download Failed"
            updateStatus("Error downloading file")
        end
    end)
end)

-- Workspace Upload Selection
local function performUpload(fileName)
    local localPath = FOLDER_NAME .. "/" .. fileName
    if not (readfile and isfile and isfile(localPath)) then return end

    local targetPath = (currentPath == "" and fileName or currentPath .. "/" .. fileName)
    updateStatus("Uploading " .. fileName .. " to " .. targetPath .. "...")

    task.spawn(function()
        local content = readfile(localPath)
        local base64Content = toBase64(content)

        local existingSha = nil
        for _, gf in ipairs(githubFiles) do
            if gf.name == fileName and gf.type == "file" then
                existingSha = gf.sha
                break
            end
        end

        local url = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, targetPath)
        local payload = {
            message = "Uploaded " .. fileName .. " via AltPre-Loader",
            content = base64Content,
            sha = existingSha
        }

        local body, code = githubRequest(url, "PUT", payload)
        if code == 200 or code == 201 then
            buildTitle.Text = "Upload Successful"
            buildDesc.Text = fileName .. " uploaded successfully to " .. GITHUB_REPO .. "/" .. currentPath
            updateStatus("Uploaded " .. fileName)
            fetchRepoFiles()
        else
            buildTitle.Text = "Upload Failed"
            buildDesc.Text = "Failed to upload. Status Code: " .. tostring(code)
            updateStatus("Upload error (Code " .. tostring(code) .. ")")
        end
    end)
end

local function openUploadSelector()
    for _, child in ipairs(uploadScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local localFiles = {}
    if listfiles and isfolder and isfolder(FOLDER_NAME) then
        local files = listfiles(FOLDER_NAME)
        for _, filePath in ipairs(files) do
            local cleanName = filePath:match("([^/]+)$") or filePath
            table.insert(localFiles, cleanName)
        end
    end

    if #localFiles == 0 then
        updateStatus("No local files in workspace/" .. FOLDER_NAME)
        return
    end

    for idx, fName in ipairs(localFiles) do
        local fBtn = Instance.new("TextButton")
        fBtn.Size = UDim2.new(1, 0, 0, 30)
        fBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        fBtn.Text = " 📄 " .. fName
        fBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        fBtn.Font = Enum.Font.Gotham
        fBtn.TextSize = 11
        fBtn.TextXAlignment = Enum.TextXAlignment.Left
        fBtn.ZIndex = 53
        fBtn.AutoButtonColor = false
        fBtn.LayoutOrder = idx
        fBtn.Parent = uploadScroll

        local fCorner = Instance.new("UICorner")
        fCorner.CornerRadius = UDim.new(0, 5)
        fCorner.Parent = fBtn
        applyRainbowStroke(fBtn, 1)

        bindClick(fBtn, function()
            uploadOverlay.Visible = false
            performUpload(fName)
        end)
    end

    uploadOverlay.Visible = true
end

bindClick(createButton, openUploadSelector)

bindClick(cancelUploadBtn, function()
    uploadOverlay.Visible = false
end)

-- ==================== PREMIUM GUI ANIMATION SYSTEM ====================
local isOpen = true

mainFrame.Visible = true
mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)

local function openGUI()
    if isOpen then return end
    isOpen = true
    playClick()
    
    mainFrame.Visible = true
    guiScale.Scale = 0.75
    mainFrame.BackgroundTransparency = 1
    
    blurEffect.Enabled = true
    TweenService:Create(blurEffect, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = 16
    }):Play()

    TweenService:Create(openButton, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1
    }):Play()

    task.delay(0.15, function()
        openButton.Visible = false
    end)

    local openTweenScale = TweenService:Create(guiScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1.0
    })
    
    local openTweenFade = TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.15
    })

    openTweenScale:Play()
    openTweenFade:Play()

    if sourceMode == "GITHUB" then
        fetchUserRepos()
    elseif sourceMode == "WORKSPACE" then
        fetchWorkspaceFiles()
    else
        renderFavoritesList()
    end
end

local function closeGUI()
    if not isOpen then return end
    isOpen = false
    playClick()

    TweenService:Create(blurEffect, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = 0
    }):Play()

    local closeTweenScale = TweenService:Create(guiScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Scale = 0.7
    })
    
    local closeTweenFade = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 1
    })

    closeTweenScale:Play()
    closeTweenFade:Play()

    openButton.Visible = true
    openButton.Size = UDim2.new(0, 0, 0, 0)
    openButton.BackgroundTransparency = 1

    TweenService:Create(openButton, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 54, 0, 54),
        BackgroundTransparency = 0.2
    }):Play()

    closeTweenFade.Completed:Connect(function()
        if not isOpen then
            mainFrame.Visible = false
            blurEffect.Enabled = false
        end
    end)
end

bindClick(openButton, openGUI)
bindClick(closeButton, closeGUI)
