bindClick(editButton, function()
    if not selectedFile then return end

    promptPassword(function()
        updateStatus("Loading file for editing...")
        task.spawn(function()
            local content = ""
            local src = selectedFile.source or sourceMode

            if src == "GITHUB" and selectedFile.download_url then
                local body, code = githubRequest(selectedFile.download_url, "GET")
                if code == 200 and body then content = body end
            elseif readfile then
                local localPath = FOLDER_NAME .. "/" .. selectedFile.name
                if isfile and isfile(localPath) then content = readfile(localPath) end
            end

