local function bindClick(btn, action)
    local isAnimating = false
    local originalSize = btn.Size
    local originalColor = btn.BackgroundColor3

    btn.Activated:Connect(function()
        if isAnimating then return end
        isAnimating = true

        TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(originalSize.X.Scale * 1.08, originalSize.X.Offset * 1.08, originalSize.Y.Scale * 1.08, originalSize.Y.Offset * 1.08),
            BackgroundColor3 = Color3.fromRGB(
                math.min(255, originalColor.R * 255 + 35),
                math.min(255, originalColor.G * 255 + 35),
                math.min(255, originalColor.B * 255 + 35)
            )
        }):Play()

        task.delay(0.1, function()
            local backTween = TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = originalSize,
                BackgroundColor3 = originalColor
            })
            backTween:Play()
            backTween.Completed:Connect(function()
                isAnimating = false
            end)
        end)

        if action then action() end
    end)
end

