-- ==================== ADVANCED STROKE & COLOR SYSTEM ====================
local strokeInstances = {}
local strokeMode = "Rainbow" -- "Rainbow", "Static", "Pulse"
local rainbowSpeed = 0.2
local staticColor = Color3.fromRGB(0, 255, 200)
local strokeThickness = 1.5
local hue = 0
local pulseTime = 0

local function applyRainbowStroke(instance, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or strokeThickness
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = instance
    table.insert(strokeInstances, stroke)
    return stroke
end

RunService.RenderStepped:Connect(function(delta)
    if strokeMode == "Rainbow" then
        hue = (hue + delta * rainbowSpeed) % 1
        local activeColor = Color3.fromHSV(hue, 0.8, 1)
        for i = #strokeInstances, 1, -1 do
            local stroke = strokeInstances[i]
            if stroke and stroke.Parent then
                stroke.Color = activeColor
                stroke.Thickness = strokeThickness
            else
                table.remove(strokeInstances, i)
            end
        end
    elseif strokeMode == "Static" then
        for i = #strokeInstances, 1, -1 do
            local stroke = strokeInstances[i]
            if stroke and stroke.Parent then
                stroke.Color = staticColor
                stroke.Thickness = strokeThickness
            else
                table.remove(strokeInstances, i)
            end
        end
    elseif strokeMode == "Pulse" then
        pulseTime = pulseTime + delta * 3
        local alpha = (math.sin(pulseTime) + 1) / 2
        local pulseColor = staticColor:Lerp(Color3.fromRGB(255, 255, 255), alpha * 0.5)
        for i = #strokeInstances, 1, -1 do
            local stroke = strokeInstances[i]
            if stroke and stroke.Parent then
                stroke.Color = pulseColor
                stroke.Thickness = strokeThickness + (alpha * 1)
            else
                table.remove(strokeInstances, i)
            end
        end
    end
end)

