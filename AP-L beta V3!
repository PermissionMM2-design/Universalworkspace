-- ==================== FLOATING SQUARES SYSTEM ====================
local squareContainer = Instance.new("Folder")
squareContainer.Name = "FloatingSquares"
squareContainer.Parent = mainFrame

local NUM_SQUARES = 18
local squaresData = {}

for i = 1, NUM_SQUARES do
    local square = Instance.new("Frame")
    local size = math.random(15, 35)
    square.Size = UDim2.new(0, size, 0, size)
    
    local startX = math.random() * 0.9
    local startY = math.random() * 0.9
    square.Position = UDim2.new(startX, 0, startY, 0)
    
    local randomColor = Color3.fromHSV(math.random(), 0.8, 1)
    square.BackgroundColor3 = randomColor
    square.BackgroundTransparency = math.random(30, 60) / 100
    square.BorderSizePixel = 0
    square.ZIndex = 0
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = square
    
    applyRainbowStroke(square, 1)
    square.Parent = squareContainer
    
    local vx = (math.random() > 0.5 and 1 or -1) * (math.random(80, 180) / 1000)
    local vy = (math.random() > 0.5 and 1 or -1) * (math.random(80, 180) / 1000)
    
    table.insert(squaresData, {
        frame = square,
        vx = vx,
        vy = vy,
        size = size
    })
end

RunService.RenderStepped:Connect(function(delta)
    if not mainFrame.Visible then return end
    local boundsX = mainFrame.AbsoluteSize.X
    local boundsY = mainFrame.AbsoluteSize.Y
    if boundsX == 0 or boundsY == 0 then return end

    for _, data in ipairs(squaresData) do
        local sq = data.frame
        local currentX = sq.Position.X.Scale
        local currentY = sq.Position.Y.Scale
        
        local nextX = currentX + data.vx * delta * 60
        local nextY = currentY + data.vy * delta * 60
        
        local pixelX = nextX * boundsX
        local pixelY = nextY * boundsY
        
        if pixelX <= 0 or (pixelX + data.size) >= boundsX then
            data.vx = -data.vx
            nextX = math.clamp(nextX, 0, (boundsX - data.size) / boundsX)
        end
        
        if pixelY <= 0 or (pixelY + data.size) >= boundsY then
            data.vy = -data.vy
            nextY = math.clamp(nextY, 0, (boundsY - data.size) / boundsY)
        end
        
        sq.Position = UDim2.new(nextX, 0, nextY, 0)
    end
end)

